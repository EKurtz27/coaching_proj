set.seed(1)
nsim <- 10000
n <- 20
A_norm <- replicate(nsim, {
x <- rnorm(n, mean=0, sd=1)        # symmetric
(mean(x) - median(x))^4
})
A_skew <- replicate(nsim, {
x <- rexp(n, rate=1)               # skewed
(mean(x) - median(x))^4
})
hist(A_norm, breaks=100, main="A_stat under Normal", xlim=c(0, max(quantile(A_skew,.99), quantile(A_norm,.99))))
hist(A_skew, breaks=100, main="A_stat under Exponential", xlim=c(0, max(quantile(A_skew,.99), quantile(A_norm,.99))))
set.seed(1)
nsim <- 10000
n <- 20
C_norm <- replicate(nsim, {
x <- rnorm(n, mean = 0, sd = 1)  # symmetric
mean(x) / (mean(x) - median(x))
})
C_skew <- replicate(nsim, {
x <- rexp(n, rate = 1)            # skewed
mean(x) / (mean(x) - median(x))
})
# Plot histograms
par(mfrow = c(1,2))
hist(C_norm, breaks = 200, xlim = c(-50, 50),
main = "C_stat under Normal (symmetric)", xlab = "C_stat")
hist(C_skew, breaks = 200, xlim = c(-50, 50),
main = "C_stat under Exponential (skewed)", xlab = "C_stat")
# Check for extreme tails
range(C_norm, na.rm = TRUE)
range(C_skew, na.rm = TRUE)
# Plot histograms
par(mfrow = c(1,2))
hist(C_norm, breaks = 200, xlim = c(-50, 50),
main = "C_stat under Normal (symmetric)", xlab = "C_stat")
hist(C_skew, breaks = 200, xlim = c(-50, 50),
main = "C_stat under Exponential (skewed)", xlab = "C_stat")
